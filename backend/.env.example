# Server
PORT=3001
NODE_ENV=development
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (PostgreSQL)
# docker-compose exposes Postgres on host port 5434 (5434:5432)
# with POSTGRES_DB=reachinbox, POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgre
DB_HOST=localhost
DB_PORT=5434
DB_NAME=reachinbox
DB_USER=postgres
DB_PASSWORD=postgre
DATABASE_URL=postgresql://postgres:postgre@localhost:5434/reachinbox

# Redis
# docker-compose exposes Redis on host port 6381 (6381:6379)
# In production (Redis Cloud / Upstash), you can set REDIS_URL instead of host/port/password
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
# REDIS_URL=redis://default:password@your-redis-host:port
# REDIS_TLS=false

# Google OAuth - https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (for CORS + redirects)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Worker Concurrency
WORKER_CONCURRENCY=5

# Min delay between sends (ms)
MIN_DELAY_BETWEEN_SENDS_MS=2000

# Slack OAuth - https://api.slack.com/apps (requires 'incoming-webhook' scope)
SLACK_CLIENT_ID=<from api.slack.com/apps>
SLACK_CLIENT_SECRET=<from api.slack.com/apps>
SLACK_REDIRECT_URI=http://localhost:3001/slack/callback

# Elasticsearch (optional - not currently used, PostgreSQL ILIKE used instead)
ELASTICSEARCH_URL=http://localhost:9200

# SMTP (Real email delivery; leave SMTP_USER/SMTP_PASS blank to fall back to Ethereal sandbox)
# For Gmail: enable 2-Step Verification and generate a 16-char App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
